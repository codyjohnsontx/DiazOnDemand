generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  COACH
  STUDENT
}

enum Discipline {
  BJJ
  MUAY_THAI
  HAGANAH
}

enum AccessLevel {
  FREE
  PAID
}

enum VideoProvider {
  MUX
  YOUTUBE
  NONE
}

enum EntitlementTier {
  FREE
  PREMIUM
}

/// Where an entitlement's current value came from. MANUAL is the default
/// because anything the Stripe webhook did not write was put there by a human
/// (a comp, the seed, or a support fix).
enum EntitlementSource {
  MANUAL
  STRIPE
}

/// What an admin did to a member's access from the admin members screen.
/// REVOKE is "Remove access": it ends a manual grant. Rows written before bans
/// existed may carry a `stripeSubscriptionId`; those withdrew Stripe access,
/// which is what a ban does now.
enum MemberAccessAction {
  GRANT
  REVOKE
  RESTORE
  BAN
  UNBAN
}

enum StripeWebhookEventStatus {
  PROCESSED
  FAILED
}

model User {
  id                  String               @id @default(uuid())
  clerkUserId         String               @unique
  role                Role                 @default(STUDENT)
  /// Set while the member is banned: no premium access whatever their
  /// subscriptions say, and checkout refuses them, until an admin lifts it.
  /// `MemberAccessAudit` holds who did it and why.
  bannedAt            DateTime?
  createdAt           DateTime             @default(now())
  progress            Progress[]
  favorites           Favorite[]
  subscriptions       Subscription[]
  entitlement         Entitlement?
  checkoutReservation CheckoutReservation?
  accessAudit         MemberAccessAudit[]  @relation("MemberAccessAuditMember")
  accessAuditActions  MemberAccessAudit[]  @relation("MemberAccessAuditActor")
}

model Program {
  id          String   @id @default(uuid())
  title       String
  description String?
  orderIndex  Int      @default(0)
  discipline  Discipline @default(BJJ)
  isFeaturedDemo Boolean @default(false)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  courses     Course[]
}

model Course {
  id          String   @id @default(uuid())
  programId   String
  title       String
  description String?
  orderIndex  Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  @@index([programId])
}

model Lesson {
  id              String       @id @default(uuid())
  courseId         String
  title            String
  description      String?
  orderIndex       Int          @default(0)
  isPublished      Boolean      @default(false)
  accessLevel      AccessLevel  @default(FREE)
  videoProvider    VideoProvider @default(MUX)
  muxAssetId       String?
  muxPlaybackId    String?
  youtubeVideoId   String?
  // The direct upload the lesson is waiting on, and the last Mux failure it
  // saw. Both are Mux-issued facts rather than a status column: the video
  // state is derived from these two plus the three identifiers above - see
  // resolveLessonVideoState in @diaz/shared.
  muxUploadId      String?
  muxVideoError    String?
  durationSeconds  Int?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  course           Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tags             LessonTag[]
  progress         Progress[]
  favorites        Favorite[]

  @@index([courseId])
}

model Tag {
  id      String      @id @default(uuid())
  name    String      @unique
  lessons LessonTag[]
}

model LessonTag {
  lessonId String
  tagId    String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([lessonId, tagId])
  @@index([tagId])
}

model Progress {
  id                  String   @id @default(uuid())
  userId              String
  lessonId            String
  lastPositionSeconds Int      @default(0)
  completed           Boolean  @default(false)
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson              Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  lessonId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
}

/// A member's subscription history, not a single current-state row. A customer
/// who cancels and resubscribes gets a new Stripe subscription id, so one row
/// per user cannot represent them - see the resubscribe regression test in
/// apps/api/src/tests/billing-lifecycle.db.test.ts.
model Subscription {
  id                   String    @id @default(uuid())
  userId               String
  stripeCustomerId     String
  stripeSubscriptionId String    @unique
  status               String
  currentPeriodEnd     DateTime?
  planId               String?
  /// Set when a refund or chargeback withdraws access. Kept separate from
  /// `status`, which mirrors Stripe, so a later Stripe event cannot undo it.
  revokedAt            DateTime?
  revokedReason        String?
  /// No longer read. It recorded an admin withdrawing access before bans existed;
  /// the member_ban migration turned every one into `User.bannedAt`. Dropped by a
  /// later migration.
  adminRevokedAt       DateTime?
  /// `created` of the newest Stripe event applied to this row. Stripe does not
  /// guarantee delivery order, so an older event must not overwrite a newer one.
  lastEventAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stripeCustomerId])
}

model Entitlement {
  id         String            @id @default(uuid())
  userId     String            @unique
  tier       EntitlementTier   @default(FREE)
  validUntil DateTime?
  source     EntitlementSource @default(MANUAL)
  updatedAt  DateTime          @updatedAt
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A checkout the member has started but not finished.
///
/// The row exists to be a lock: `userId` is unique, so two concurrent checkout
/// requests cannot both reserve, and the loser is refused cleanly instead of
/// opening a second Stripe session and being charged twice. Measured before
/// this existed: an established member clicking twice at once got two sessions.
///
/// It is deliberately short-lived. `expiresAt` bounds how long a member can be
/// stranded if the process dies between reserving and hearing back from Stripe,
/// and the Stripe `checkout.session.*` webhooks clear it as soon as the checkout
/// actually resolves.
model CheckoutReservation {
  id              String   @id @default(uuid())
  userId          String   @unique
  /// Set once Stripe has issued the session, so a `checkout.session.*` event can
  /// find the reservation it belongs to.
  stripeSessionId String?  @unique
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

/// Every Stripe webhook delivery this API has verified, and what happened to
/// it. Doubles as the idempotency key (Stripe redelivers) and as the record the
/// owner can query when a payment did not turn into access.
model StripeWebhookEvent {
  /// Stripe's own event id (`evt_...`).
  id                   String                   @id
  type                 String
  status               StripeWebhookEventStatus
  /// `created` on the Stripe event, i.e. when Stripe generated it.
  stripeCreatedAt      DateTime
  error                String?
  attempts             Int                      @default(1)
  /// Set only on the delivery that raised the alert for a paying subscription
  /// nobody got access from: one matching no member, or one that joined an admin
  /// revocation. That is what makes the alert fire exactly once per subscription
  /// instead of on every renewal, while still firing when a subscription starts
  /// `incomplete` and goes live later.
  stripeSubscriptionId String?
  receivedAt           DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([status, receivedAt])
  @@index([stripeSubscriptionId])
}

/// Who changed a member's access from the admin members screen, what they did,
/// why, and when. Append-only: nothing in the API updates or deletes a row.
///
/// The before and after values are the stored entitlement around the change, so
/// a row says what the member could watch on either side of it without having
/// to replay the history.
model MemberAccessAudit {
  id                   String             @id @default(uuid())
  memberId             String
  /// Null once the acting admin's own account is deleted, so their history does
  /// not vanish with them; `actorClerkUserId` still says who it was.
  actorId              String?
  actorClerkUserId     String
  action               MemberAccessAction
  reason               String?
  tierBefore           EntitlementTier
  validUntilBefore     DateTime?
  tierAfter            EntitlementTier
  validUntilAfter      DateTime?
  /// The subscription a REVOKE withdrew or a RESTORE cleared. Null on a REVOKE
  /// that only ended a manual grant, and on a GRANT.
  stripeSubscriptionId String?
  createdAt            DateTime           @default(now())
  member               User               @relation("MemberAccessAuditMember", fields: [memberId], references: [id], onDelete: Cascade)
  actor                User?              @relation("MemberAccessAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([memberId, createdAt])
  @@index([actorId])
}
