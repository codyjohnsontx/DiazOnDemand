NEXT_PUBLIC_API_URL=http://localhost:4000
# DANGER: client-side half of DEV_BYPASS_AUTH. It skips the Clerk sign-in flow and
# sends NEXT_PUBLIC_DEV_USER_ID instead, so together with DEV_BYPASS_AUTH=true on the
# API a request with NO credentials at all is authenticated as the seeded admin - full
# read/create/edit/publish/delete of all content plus every paid video. Turn it on only
# for local work against a local throwaway database. The API refuses to start with the
# bypass enabled unless DATABASE_URL points at localhost.
NEXT_PUBLIC_DEV_BYPASS_AUTH=false
NEXT_PUBLIC_DEV_USER_ID=dev_clerk_user
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key
VOD_COMING_SOON=false
NEXT_PUBLIC_VOD_COMING_SOON=false
