NEXT_PUBLIC_API_URL=http://localhost:4000
# DANGER: client-side half of DEV_BYPASS_AUTH. It skips the Clerk sign-in flow and
# sends NEXT_PUBLIC_DEV_USER_ID instead, so together with DEV_BYPASS_AUTH=true on the
# API a request with NO credentials at all is authenticated as the seeded admin - full
# read/create/edit/publish/delete of all content plus every paid video. Turn it on only
# for local work against a local throwaway database. The API refuses to start with the
# bypass enabled unless DATABASE_URL points at a loopback host: localhost, any 127.x.x.x
# address such as 127.0.0.1, or the IPv6 loopback written as [::1].
NEXT_PUBLIC_DEV_BYPASS_AUTH=false
NEXT_PUBLIC_DEV_USER_ID=dev_clerk_user
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key
# Next.js reads this file, not the monorepo-root .env, so the secret key is required here too
# even though the root and apps/api examples also carry one. clerkMiddleware asserts it in the
# Edge runtime before any handler runs, so omitting it serves `@clerk/nextjs: Missing secretKey`
# as a 500 on EVERY route - the unprotected home page included, not only the protected ones.
# Both Clerk values here are placeholders, so a verbatim copy of this file still 500s (at
# `Publishable key not valid`) until you paste real keys. See "Local Setup" in README.md.
CLERK_SECRET_KEY=sk_test_your_key
VOD_COMING_SOON=false
NEXT_PUBLIC_VOD_COMING_SOON=false
