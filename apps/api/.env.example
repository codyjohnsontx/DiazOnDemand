# Both Clerk values are required whenever DEV_BYPASS_AUTH=false, which is the
# shipped default - the API refuses to start without them.
CLERK_JWT_ISSUER=https://your-tenant.clerk.accounts.dev
CLERK_SECRET_KEY=sk_test_your_key
CORS_ORIGIN=http://localhost:3000,http://localhost:8081
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/diaz_ondemand
DEFAULT_DEV_CLERK_USER_ID=dev_clerk_user
# DANGER: with DEV_BYPASS_AUTH=true, a request with NO credentials at all is
# authenticated as the seeded admin - full read/create/edit/publish/delete of all
# content plus every paid video. Turn it on only for local work against a local
# throwaway database. The API refuses to start with it enabled unless
# DATABASE_URL points at a loopback host: localhost, any 127.x.x.x address such
# as 127.0.0.1, or the IPv6 loopback written as [::1]. This file lives inside the
# service you deploy, so it is the one most likely to be copied onto a server -
# keep it false.
DEV_BYPASS_AUTH=false
# Webhook signing secret. Locally the Mux CLI prints one when you run
# `mux webhooks listen --forward-to http://localhost:4000/webhooks/mux`; on a
# deployment it comes from the dashboard webhook. Optional locally, required on
# any deployment - NODE_ENV=production or a DATABASE_URL that is not loopback -
# with no "is Mux enabled" condition attached, because without it every Mux
# delivery is rejected and no asset is ever ingested.
MUX_WEBHOOK_SECRET=
# Signing key - Settings > Signing Keys in the Mux dashboard. A DIFFERENT
# credential from the Mux access token: it signs the RS256 playback JWTs that
# gate PAID lessons. The private key is base64-encoded so it fits on one line,
# and is shown only once. Optional locally, required on any deployment -
# NODE_ENV=production or a DATABASE_URL that is not loopback - with no "is Mux
# enabled" condition attached, or the API exits at startup instead of serving
# paid video over an unsigned url. See "Vercel Deployment Notes" in README.md.
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE=
PORT=4000
STRIPE_PRICE_ID_MONTHLY=price_monthly_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
WEB_APP_URL=http://localhost:3000

DIAZ_INTERNAL_API_KEY=replace_with_strong_internal_key
