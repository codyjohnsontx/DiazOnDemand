PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/diaz_ondemand
CORS_ORIGIN=http://localhost:3000,http://localhost:8081
WEB_APP_URL=http://localhost:3000
# DANGER: with DEV_BYPASS_AUTH=true, a request with NO credentials at all is
# authenticated as the seeded admin - full read/create/edit/publish/delete of all
# content plus every paid video. Turn it on only for local work against a local
# throwaway database. The API refuses to start with it enabled unless
# DATABASE_URL points at localhost. This file lives inside the service you
# deploy, so it is the one most likely to be copied onto a server - keep it false.
DEV_BYPASS_AUTH=false
DEFAULT_DEV_CLERK_USER_ID=dev_clerk_user
CLERK_SECRET_KEY=sk_test_your_key
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID_MONTHLY=price_monthly_xxx

DIAZ_INTERNAL_API_KEY=replace_with_strong_internal_key
