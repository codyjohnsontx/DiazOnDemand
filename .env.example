# Shared
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/diaz_ondemand

# Auth (Clerk)
CLERK_PUBLISHABLE_KEY=pk_test_your_key
CLERK_SECRET_KEY=sk_test_your_key
CLERK_JWT_ISSUER=https://your-tenant.clerk.accounts.dev
DEV_BYPASS_AUTH=true
DEFAULT_DEV_CLERK_USER_ID=dev_clerk_user

# API / web integration
NEXT_PUBLIC_DEV_BYPASS_AUTH=true
PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DEV_USER_ID=dev_clerk_user
WEB_APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:8081
NEXT_PUBLIC_MARKETING_SITE_URL=https://www.diazmartialarts.com
VOD_COMING_SOON=false
NEXT_PUBLIC_VOD_COMING_SOON=false

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID_MONTHLY=price_monthly_xxx
# Optional Slack/Discord incoming webhook that billing failures are POSTed to.
# Leave it commented out to keep alerts log-only; they are always logged
# prefixed BILLING_ALERT. It must be a full URL when set - an empty value is
# rejected by env validation, not treated as unset.
# BILLING_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/xxx

# Mux (optional for MVP)
# API access token - Settings > Access Tokens. Used for REST calls and `mux login`.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# Webhook signing secret. Locally the Mux CLI prints one when you run
# `mux webhooks listen --forward-to http://localhost:4000/webhooks/mux`;
# in production it comes from the dashboard webhook. Required in production
# whenever MUX_TOKEN_ID is set.
MUX_WEBHOOK_SECRET=
# Signing key - Settings > Signing Keys. A DIFFERENT credential from the access
# token above: it signs the RS256 playback JWTs that gate PAID lessons. The
# private key is base64-encoded so it fits on one line, and is shown only once.
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE=

# Seed
SEED_DEV_CLERK_USER_ID=dev_clerk_user

# Mobile
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_DEV_BYPASS_AUTH=true
EXPO_PUBLIC_DEV_USER_ID=dev_clerk_user
EXPO_PUBLIC_SUBSCRIBE_URL=http://localhost:3000/subscribe
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key

# Internal server-to-server auth
DIAZ_INTERNAL_API_KEY=replace_with_strong_internal_key
