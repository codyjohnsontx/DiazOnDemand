# Shared
# Leave NODE_ENV unset for local development. Deployed runs start through
# `pnpm start`, which sets NODE_ENV=production itself so it never depends on the
# host exporting it.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/diaz_ondemand

# Auth (Clerk)
CLERK_JWT_ISSUER=https://your-tenant.clerk.accounts.dev
CLERK_PUBLISHABLE_KEY=pk_test_your_key
CLERK_SECRET_KEY=sk_test_your_key
DEFAULT_DEV_CLERK_USER_ID=dev_clerk_user
# DANGER: with DEV_BYPASS_AUTH=true, a request with NO credentials at all is
# authenticated as the seeded admin - full read/create/edit/publish/delete of all
# content plus every paid video. Turn it on only for local work against a local
# throwaway database. The API refuses to start with it enabled unless
# DATABASE_URL points at a loopback host: localhost, any 127.x.x.x address such
# as 127.0.0.1, or the IPv6 loopback written as [::1].
DEV_BYPASS_AUTH=false

# API / web integration
# Set this in apps/diaz-ondemand-web/.env - Next.js does not read this file.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key
# Client-side half of the bypass above: skips the Clerk sign-in flow and sends
# NEXT_PUBLIC_DEV_USER_ID instead. Only useful alongside DEV_BYPASS_AUTH=true.
NEXT_PUBLIC_DEV_BYPASS_AUTH=false
PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DEV_USER_ID=dev_clerk_user
WEB_APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:8081
NEXT_PUBLIC_MARKETING_SITE_URL=https://www.diazmartialarts.com
VOD_COMING_SOON=false
NEXT_PUBLIC_VOD_COMING_SOON=false

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID_MONTHLY=price_monthly_xxx

# Mux (optional for MVP, except the signing key pair below)
# API access token - Settings > Access Tokens. Used for REST calls and `mux login`.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# Webhook signing secret. Locally the Mux CLI prints one when you run
# `mux webhooks listen --forward-to http://localhost:4000/webhooks/mux`;
# on a deployment it comes from the dashboard webhook. Optional locally,
# required on any deployment - NODE_ENV=production or a DATABASE_URL that is not
# loopback - with no "is Mux enabled" condition attached, because without it
# every Mux delivery is rejected and no asset is ever ingested.
MUX_WEBHOOK_SECRET=
# Signing key - Settings > Signing Keys. A DIFFERENT credential from the access
# token above: it signs the RS256 playback JWTs that gate PAID lessons. The
# private key is base64-encoded so it fits on one line, and is shown only once.
# Optional locally, required on any deployment - NODE_ENV=production or a
# non-loopback DATABASE_URL - with no "is Mux enabled" condition attached, or
# the API exits at startup. See "Vercel Deployment Notes" in README.md.
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE=

# Seed
SEED_DEV_CLERK_USER_ID=dev_clerk_user

# Mobile
EXPO_PUBLIC_API_URL=http://localhost:4000
# Same client-side bypass as NEXT_PUBLIC_DEV_BYPASS_AUTH, for the Expo app.
EXPO_PUBLIC_DEV_BYPASS_AUTH=false
EXPO_PUBLIC_DEV_USER_ID=dev_clerk_user
EXPO_PUBLIC_SUBSCRIBE_URL=http://localhost:3000/subscribe
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key

# Internal server-to-server auth
DIAZ_INTERNAL_API_KEY=replace_with_strong_internal_key
