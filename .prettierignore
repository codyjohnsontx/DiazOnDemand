# Prettier also reads the root .gitignore, so build output, dependencies and env
# files are already skipped. It does not read nested .gitignore files, so paths
# ignored only there are repeated below, along with the extra paths it must not touch.

# Generated by pnpm; rewritten on every install.
pnpm-lock.yaml

# Project memory loaded into every agent session. Edited only to correct facts,
# never reflowed.
AGENTS.md
CLAUDE.md

# Local agent tooling, ignored through a global excludes file rather than
# .gitignore, so Prettier cannot see that it is untracked.
.claude/
.opencode/

# Clerk keyless dev mode output, ignored only by apps/diaz-ondemand-web/.gitignore.
# Holds a dev secret key.
.clerk/
